{
  "name": "andy-personal-webpage",
  "homepage": "https://andycao.me",
  "version": "0.1.4",
  "description": "Andy's personal website v2022",
  "license": "MIT",
  "authors": "Andy Cao <caojundan@gmail.com> (https://github.com/f1982)",
  "private": true,
  "engines": {
    "node": ">=22.21.0 <23",
    "pnpm": ">=11.28.5 <12"
  },
  "scripts": {
    "dev": "pnpm content && next dev",
    "start": "next start",
    "build": "pnpm content && next build",
    "postbuild": "next-sitemap",
    "content": "node scripts/build-content.mjs",
    "typecheck": "pnpm content && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest",
    "release": "standard-version",
    "release:minor": "standard-version --release-as minor",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@formatjs/intl-localematcher": "^0.9.0",
    "@opennextjs/cloudflare": "^1.20.9",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-slot": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.0.0",
    "lucide-react": "^1.53.0",
    "negotiator": "^1.1.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.0",
    "js-yaml": "^5.4.3",
    "next-sitemap": "^4.2.3",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "schema-dts": "^2.1.0",
    "standard-version": "^9.5.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0"
  },
  "packageManager": "pnpm@11.28.5",
  "volta": {
    "node": "22.21.0",
    "pnpm": "11.28.5"
  }
}
