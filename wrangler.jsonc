{
  "main": ".open-next/worker.js",
  "name": "andycao",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Lets next/image resize and convert images (AVIF/WebP) on Cloudflare.
  // Without it, OpenNext serves every image at its original size.
  "images": {
    "binding": "IMAGES"
  }
}
